{
  extends: [
    ':enableRenovate',
    ':semanticCommits',
    'config:best-practices',
  ],
  timezone: 'UTC',
  dependencyDashboard: true,
  platformCommit: 'enabled',
  prCreation: 'not-pending',
  automergeStrategy: 'squash',
  suppressNotifications: [
    'prIgnoreNotification',
  ],
  rebaseWhen: 'conflicted',
  enabledManagers: [
    'gradle',
    'gradle-wrapper',
    'github-actions',
    'custom.regex',
  ],
  customManagers: [
    {
      // the HMC-Specifics release the MCP server downloads and installs into the clients it launches
      customType: 'regex',
      managerFilePatterns: [
        '/^src/main/resources/application\\.properties$/',
      ],
      matchStrings: [
        'hmc\\.mcp\\.specifics\\.version=(?<currentValue>\\S+)',
      ],
      depNameTemplate: 'headlesshq/hmc-specifics',
      datasourceTemplate: 'github-releases',
    },
  ],
  packageRules: [
    {
      // dependency updates affect the released artifacts, so they should trigger a release
      matchManagers: [
        'gradle',
        'custom.regex',
      ],
      semanticCommitType: 'fix',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: [
        'gradle-wrapper',
      ],
      semanticCommitType: 'build',
      semanticCommitScope: 'deps',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      semanticCommitType: 'ci',
      semanticCommitScope: 'deps',
    },
    {
      // the Quarkus platform, its Gradle plugin and the BOM share a version
      matchPackageNames: [
        'io.quarkus:**',
        'io.quarkus.platform:**',
        'io.quarkus',
      ],
      groupName: 'Quarkus',
    },
    {
      // all HeadlessMc libraries share a version
      matchPackageNames: [
        'io.github.headlesshq:headlessmc**',
      ],
      groupName: 'HeadlessMc',
    },
    {
      // hmc-specifics-api is built from the hmc-specifics submodule, it is not published
      matchPackageNames: [
        'me.earth.headlessmc:hmc-specifics-api',
      ],
      enabled: false,
    },
    {
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'dependency/major',
      ],
    },
    {
      matchUpdateTypes: [
        'minor',
      ],
      addLabels: [
        'dependency/minor',
      ],
    },
    {
      matchUpdateTypes: [
        'patch',
      ],
      addLabels: [
        'dependency/patch',
      ],
    },
  ],
}
